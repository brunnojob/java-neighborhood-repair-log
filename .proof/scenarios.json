{
  "repository": "brunnojob/java-neighborhood-repair-log",
  "inputs": [
    ".proof/scenarios.json",
    ".proof/demo.py"
  ],
  "cases": [
    {
      "name": "javac -Xlint:all -Werror RepairLog.java",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "javac -Xlint:all -Werror RepairLog.java"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "python -m unittest discover -v -s tests",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m unittest discover -v -s tests"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "Persist a maintenance ticket with optimistic revision checks",
      "argv": [
        "python",
        ".proof/demo.py"
      ],
      "contains": [
        "\"stale_revision_rejected\": true"
      ],
      "timeout": 120
    }
  ]
}
